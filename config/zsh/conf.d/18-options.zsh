# Interactive shell options
# These were enabled by oh-my-zsh on the old machine; set them here so the
# behaviour carries over without depending on oh-my-zsh.

setopt AUTO_CD          # type a directory path (e.g. `~`) to cd into it
setopt AUTO_PUSHD       # `cd` pushes onto the dir stack; jump back with `cd -<TAB>`
setopt PUSHD_IGNORE_DUPS
setopt INTERACTIVE_COMMENTS  # allow `#` comments on the interactive command line
